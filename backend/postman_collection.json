{
  "info": {
    "name": "Whitfield Fulfillment WMS API",
    "description": "Postman Collection for Whitfield Fulfillment WMS Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "description": "WMS API base URL"
    },
    {
      "key": "jwt_token",
      "value": "",
      "description": "JWT access token — auto-populated by the Login request test script"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get Health (v1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/health",
              "host": ["{{base_url}}"],
              "path": ["v1", "health"]
            },
            "description": "Retrieve application health status via /v1/health. Verifies API server and MongoDB connectivity."
          },
          "response": []
        },
        {
          "name": "Get Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Retrieve application health status. Verifies API server and MongoDB connectivity."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Root",
      "item": [
        {
          "name": "Root Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": []
            },
            "description": "Root ping endpoint. Returns server status confirmation."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', json.access_token);",
                  "    pm.environment.set('jwt_token', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"email\": \"owner@example.com\",\n    \"password\": \"yourpassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate user credentials and receive access + refresh tokens. Auto-saves access_token to collection variable and environment."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Refresh JWT access token using a valid refresh token."
          },
          "response": []
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Retrieve authenticated user profile, role, assigned warehouse, and tier."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Warehouses",
      "item": [
        {
          "name": "Create Warehouse",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"name\": \"Main Warehouse\",\n    \"code\": \"MWH\",\n    \"address\": \"123 Fulfillment Ave\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/warehouses",
              "host": ["{{base_url}}"],
              "path": ["warehouses"]
            },
            "description": "Create a new warehouse facility. Owner role required.\n\nRaises:\n    HTTPException 400: Duplicate warehouse code.\n    HTTPException 403: Forbidden if not Owner.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "List Warehouses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/warehouses?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["warehouses"],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "List all warehouse facilities. Owner or Manager role required.\n\nRaises:\n    HTTPException 403: Forbidden for Staff.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Get Warehouse",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/warehouses/{{warehouse_id}}",
              "host": ["{{base_url}}"],
              "path": ["warehouses", "{{warehouse_id}}"]
            },
            "description": "Retrieve warehouse facility details by ID.\n\nRaises:\n    HTTPException 404: Warehouse not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Update Warehouse",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"name\": \"Updated Warehouse Name\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/warehouses/{{warehouse_id}}",
              "host": ["{{base_url}}"],
              "path": ["warehouses", "{{warehouse_id}}"]
            },
            "description": "Update warehouse facility details. Owner role required.\n\nRaises:\n    HTTPException 404: Warehouse not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create Manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"email\": \"manager@example.com\",\n    \"password\": \"securepassword\",\n    \"full_name\": \"John Manager\",\n    \"warehouse_id\": \"{{warehouse_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/managers",
              "host": ["{{base_url}}"],
              "path": ["users", "managers"]
            },
            "description": "Create a Manager user account assigned to a warehouse. Owner role required.\n\nRaises:\n    HTTPException 400: Email already registered or invalid warehouse.\n    HTTPException 403: Forbidden for non-Owners.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Create Staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"email\": \"staff@example.com\",\n    \"password\": \"securepassword\",\n    \"full_name\": \"Jane Staff\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/staff",
              "host": ["{{base_url}}"],
              "path": ["users", "staff"]
            },
            "description": "Create a Staff user account scoped to Manager's warehouse. Manager role required.\n\nRaises:\n    HTTPException 400: Email already registered.\n    HTTPException 403: Forbidden for non-Managers.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" },
                { "key": "role", "value": "", "disabled": true }
              ]
            },
            "description": "List user accounts with RBAC and warehouse scoping. Owner or Manager role required."
          },
          "response": []
        },
        {
          "name": "Update Staff",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"tier\": \"senior\",\n    \"function_roles\": [\"receiving\", \"packing\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/staff/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "staff", "{{user_id}}"]
            },
            "description": "Update staff user account properties (experience tier, function roles).\n\nRaises:\n    HTTPException 404: Staff user not found.\n    HTTPException 403: Cross-warehouse update prohibited.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"reassign_to_manager_id\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            },
            "description": "Deactivate a user account (soft delete). Deactivating a Manager requires reassign_to_manager_id if they have active staff.\n\nRaises:\n    HTTPException 400: Active staff exist without reassignment.\n    HTTPException 404: User not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Audit Log",
      "item": [
        {
          "name": "Get Audit Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/audit?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["audit"],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" },
                { "key": "actor_id", "value": "", "disabled": true },
                { "key": "collection", "value": "", "disabled": true },
                { "key": "action", "value": "", "disabled": true }
              ]
            },
            "description": "Retrieve system audit log records. Owner and Manager roles only.\n\nRaises:\n    HTTPException 403: Prohibited for Staff role.\n    HTTPException 500: Internal server error."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Inbox & Announcements",
      "item": [
        {
          "name": "Announce Shipment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"warehouse_id\": \"{{warehouse_id}}\",\n    \"tracking_number\": \"1Z999AA10123456784\",\n    \"carrier\": \"UPS\",\n    \"expected_items\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/inbox",
              "host": ["{{base_url}}"],
              "path": ["inbox"]
            },
            "description": "Announce an incoming parcel shipment (status ANNOUNCED).\n\nRaises:\n    HTTPException 404: Warehouse not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "List Shipments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/inbox?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["inbox"],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" },
                { "key": "status_filter", "value": "", "disabled": true }
              ]
            },
            "description": "List inbox shipment announcements filterable by status."
          },
          "response": []
        },
        {
          "name": "Accept Shipment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/inbox/{{inbox_id}}/accept",
              "host": ["{{base_url}}"],
              "path": ["inbox", "{{inbox_id}}", "accept"]
            },
            "description": "Accept an inbox shipment announcement. Manager or Owner role required.\n\nRaises:\n    HTTPException 404: Shipment not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Decline Shipment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/inbox/{{inbox_id}}/decline",
              "host": ["{{base_url}}"],
              "path": ["inbox", "{{inbox_id}}", "decline"]
            },
            "description": "Decline an inbox shipment announcement. Manager or Owner role required.\n\nRaises:\n    HTTPException 404: Shipment not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Revert Shipment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"comment\": \"Missing item specification, please re-submit.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inbox/{{inbox_id}}/revert",
              "host": ["{{base_url}}"],
              "path": ["inbox", "{{inbox_id}}", "revert"]
            },
            "description": "Revert an inbox shipment to NEEDS_SPEC state with comment. Manager or Owner role required.\n\nRaises:\n    HTTPException 404: Shipment not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Arrivals & Ticketing",
      "item": [
        {
          "name": "Process Arrival",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"warehouse_id\": \"{{warehouse_id}}\",\n    \"tracking_number\": \"1Z999AA10123456784\",\n    \"no_ticket_arrival\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/arrivals",
              "host": ["{{base_url}}"],
              "path": ["arrivals"]
            },
            "description": "Log physical parcel arrival at a warehouse facility. Matches carrier tracking number to an accepted inbox announcement. Generates atomic ticket ID ({WH}-{YYYYMMDD}-{SEQ:03d}).\n\nRaises:\n    HTTPException 404: Warehouse not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Ticketing, Inspection & Storage",
      "item": [
        {
          "name": "Log Item Scan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Unique key to prevent duplicate item creation on retries"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"barcode\": \"ABC123456\",\n    \"description\": \"Electronics item\",\n    \"condition\": \"good\",\n    \"weight_kg\": 1.5\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_id}}/items",
              "host": ["{{base_url}}"],
              "path": ["tickets", "{{ticket_id}}", "items"]
            },
            "description": "Log a scanned item unit under a ticket. Requires Idempotency-Key header to prevent duplicate item creation on retries.\n\nRaises:\n    HTTPException 400: Missing idempotency key.\n    HTTPException 404: Ticket not found.\n    HTTPException 409: Duplicate idempotency request.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Submit Inspection",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_id}}/submit-inspection",
              "host": ["{{base_url}}"],
              "path": ["tickets", "{{ticket_id}}", "submit-inspection"]
            },
            "description": "Submit completed ticket item logging for Manager inspection review. Transitions ticket status to PENDING_INSPECTION.\n\nRaises:\n    HTTPException 404: Ticket not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "List Approvals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/approvals?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["approvals"],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Retrieve manager queue of tickets pending inspection approval. Manager or Owner role required."
          },
          "response": []
        },
        {
          "name": "Approve Ticket",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["tickets", "{{ticket_id}}", "approve"]
            },
            "description": "Approve ticket inspection. Transitions ticket and non-damaged items to SHIPMENT_ARRIVED (sellable stock). Manager or Owner only.\n\nRaises:\n    HTTPException 404: Ticket not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Store Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"storage_location_code\": \"A-04-12\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_id}}/store",
              "host": ["{{base_url}}"],
              "path": ["tickets", "{{ticket_id}}", "store"]
            },
            "description": "Assign storage location code to ticket and attached items (transitions to STORED).\n\nRaises:\n    HTTPException 404: Ticket not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "Image file (.jpg, .png, .webp)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/uploads",
              "host": ["{{base_url}}"],
              "path": ["uploads"]
            },
            "description": "Upload item photo image file (.jpg, .png, .webp).\n\nRaises:\n    HTTPException 400: Invalid file extension format.\n    HTTPException 500: Internal server error."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Storage Locations",
      "item": [
        {
          "name": "Create Storage Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"warehouse_id\": \"{{warehouse_id}}\",\n    \"zone\": \"A\",\n    \"rack\": \"04\",\n    \"bin\": \"12\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/storage-locations",
              "host": ["{{base_url}}"],
              "path": ["storage-locations"]
            },
            "description": "Create a new physical storage location bin (e.g. A-04-12). Manager or Owner only.\n\nRaises:\n    HTTPException 400: Duplicate location code.\n    HTTPException 404: Warehouse not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "List Storage Locations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/storage-locations?warehouse_id={{warehouse_id}}&skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["storage-locations"],
              "query": [
                { "key": "warehouse_id", "value": "{{warehouse_id}}" },
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "List physical storage locations for a warehouse facility."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders & Fulfillment",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"order_ref\": \"ORD-2026-001\",\n    \"warehouse_id\": \"{{warehouse_id}}\",\n    \"customer_name\": \"John Doe\",\n    \"items\": [\n        {\"sku\": \"ABC123\", \"quantity\": 2}\n    ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            },
            "description": "Intake a new customer order (status PENDING).\n\nRaises:\n    HTTPException 400: Duplicate order ID.\n    HTTPException 404: Warehouse not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Reserve Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/reserve",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "reserve"]
            },
            "description": "Atomically reserve stock for an order inside a MongoDB transaction (STORED -> RESERVED). Concurrent reservation attempts for identical units yield HTTP 409 Conflict.\n\nRaises:\n    HTTPException 400: Insufficient available stock.\n    HTTPException 404: Order not found.\n    HTTPException 409: Concurrent reservation conflict.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Get Picklist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/picklist",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "picklist"]
            },
            "description": "Generate picklist showing physical bin storage locations for reserved order units.\n\nRaises:\n    HTTPException 404: Order not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Pack Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n    \"weight_kg\": 2.5,\n    \"length_cm\": 30,\n    \"width_cm\": 20,\n    \"height_cm\": 15\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/pack",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "pack"]
            },
            "description": "Confirm packed order weight and package dimensions (transitions status to PACKED).\n\nRaises:\n    HTTPException 404: Order not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Generate Label",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/label",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "label"]
            },
            "description": "Generate stub carrier shipping label and tracking number.\n\nRaises:\n    HTTPException 404: Order not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Ship Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/ship",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "ship"]
            },
            "description": "Ship customer order and transition reserved item units to SOLD state.\n\nRaises:\n    HTTPException 404: Order not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "cancel"]
            },
            "description": "Cancel order reservation and release items back to STORED status.\n\nRaises:\n    HTTPException 404: Order not found.\n    HTTPException 500: Internal server error."
          },
          "response": []
        }
      ]
